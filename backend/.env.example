# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# Local testing only. Production must set false.
ENABLE_DEV_LOGIN=true
COOKIE_SAME_SITE=lax

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdgoc_tasks?schema=public"
# Migration connection; same URL locally. Supabase can use its session pooler (5432).
# Hosted setup and SSL requirements: docs/backend/SUPABASE.md.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gdgoc_tasks?schema=public"
# Optional: a dedicated local test database; tests use an isolated temporary schema.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdgoc_tasks_test?schema=public"

# Session Management
# Replace with a generated secret. This development placeholder is rejected in production.
SESSION_SECRET="development_replace_with_random_secret"

# System Bootstrap
# Upon signing in with Google, if the verified email matches this, the user is elevated to SYSTEM_OWNER.
# Club-owned bootstrap account.
SYSTEM_OWNER_EMAIL="gdgoc.psit@gmail.com"

# Google OAuth 2.0 Credentials (Console: https://console.cloud.google.com/)
GOOGLE_AUTH_ENABLED=true
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# GitHub Webhook Integration
# Set this secret in GitHub repo settings -> Webhooks -> Secret
GITHUB_WEBHOOK_SECRET="your-github-webhook-shared-secret"
# GitHub Personal Access Token (PAT) for backend verification or PR queries (optional/read-only)
GITHUB_PAT=""

# Optional for local DB/API development; required in production.
# REDIS_URL="redis://127.0.0.1:6379/0"
REDIS_PREFIX=gdgoc-development
WORKER_MODE=embedded
PROCESS_ROLE=web
REDIS_TRANSPORT=tls
ALLOW_SELF_REGISTRATION=false
# On Render, use REDIS_TRANSPORT=render-internal only with its private Key Value URL.
# Google can be explicitly disabled while cloud credentials are pending; no sign-in is then available.
