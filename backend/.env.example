# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdgoc_tasks?schema=public"
# Use a direct (non-pooler) URL for Prisma migrations; same URL locally.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gdgoc_tasks?schema=public"
# Optional: a dedicated local test database; tests use an isolated temporary schema.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdgoc_tasks_test?schema=public"

# Session Management
SESSION_SECRET="super-secret-random-key-at-least-32-chars-long"

# System Bootstrap
# Upon signing in with Google, if the verified email matches this, the user is elevated to SYSTEM_OWNER.
# Club-owned bootstrap account.
SYSTEM_OWNER_EMAIL="gdgoc.psit@gmail.com"

# Google OAuth 2.0 Credentials (Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# GitHub Webhook Integration
# Set this secret in GitHub repo settings -> Webhooks -> Secret
GITHUB_WEBHOOK_SECRET="your-github-webhook-shared-secret"
# GitHub Personal Access Token (PAT) for backend verification or PR queries (optional/read-only)
GITHUB_PAT=""
