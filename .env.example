# GDGOC Club Task Management System - Root Environment Template
# Copy this file to backend/.env, frontend/client/.env, and frontend/admin/.env respectively.

# ==========================================
# BACKEND (backend/.env)
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdgoc_tasks?schema=public"
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-secret"
SYSTEM_OWNER_EMAIL="aditya.lead@example.com"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"
GITHUB_WEBHOOK_SECRET="your-github-webhook-hmac-secret"
GITHUB_PAT=""

# ==========================================
# MEMBER FRONTEND (frontend/client/.env)
# ==========================================
VITE_API_URL="http://localhost:5000/api/v1"

# ==========================================
# ADMIN FRONTEND (frontend/admin/.env)
# ==========================================
VITE_API_URL="http://localhost:5000/api/v1"
